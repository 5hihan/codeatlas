{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "codeatlas",
            "args": [
              "hook",
              "session-start",
              "--prefix",
              "mcp__plugin_codeatlas_atlas"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Grep|Glob|Bash|Read|Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "codeatlas",
            "args": [
              "hook",
              "pretool",
              "--prefix",
              "mcp__plugin_codeatlas_atlas"
            ],
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "mcp__plugin_codeatlas_atlas__.*",
        "hooks": [
          {
            "type": "command",
            "command": "codeatlas",
            "args": [
              "hook",
              "pretool",
              "--prefix",
              "mcp__plugin_codeatlas_atlas"
            ],
            "timeout": 5
          }
        ]
      }
    ]
  }
}
